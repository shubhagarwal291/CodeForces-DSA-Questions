#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;

    vector<int> a(n);
    int sum = 0;

    for (int &x : a) {
        cin >> x;
        sum += x;
    }

    sort(a.rbegin(), a.rend());

    int taken = 0, count = 0;

    for (int x : a) {
        taken += x;
        sum -= x;
        count++;

        if (taken > sum)
            break;
    }

    cout << count << endl;

    return 0;
}
